# E-Sparven
ESPARVEN_KEY=your_key_here
ESPARVEN_TEAM_ID=67

# JSONbin
JSONBIN_KEY=your_master_key_here
JSONBIN_INDEX_BIN_ID=   # fill after first run creates it

# Optional: Discord webhook for notifications
DISCORD_WEBHOOK_URL=

# Optional: Discord bot for scheduled-event creation (12 days out or closer).
# Different credential from the webhook above -- webhooks can't create
# scheduled events, only a bot with MANAGE_EVENTS in the target guild can.
# See discord_events.py's module docstring for full setup steps.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
