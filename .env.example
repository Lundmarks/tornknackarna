# E-Sparven
ESPARVEN_KEY=your_key_here
ESPARVEN_TEAM_ID=67

# GitHub (for Gist storage)
GITHUB_TOKEN=your_github_pat_here
GITHUB_USERNAME=Lundmarks

# Gist IDs (auto-filled after first run)
GIST_INDEX_ID=

# Optional: Discord webhook for notifications
DISCORD_WEBHOOK_URL=

# Optional: comma-separated UTC times to run the bot each day (default: 3x per day)
RUN_TIMES=06:00,14:00,22:00
